<section class="section" style="text-align:center;">
  <div class="container" style="max-width:520px;">
    <h1 class="wordmark" style="font-size:2rem;">{{ shop.name }}</h1>
    <p class="lead" style="margin-inline:auto;">Opening soon.</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Password" aria-label="Store password">
      <button type="submit" class="btn btn--primary" style="max-width:240px;margin:1rem auto 0;">Enter</button>
    {% endform %}
  </div>
</section>
