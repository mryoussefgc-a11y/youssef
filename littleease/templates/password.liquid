<section class="le-section le-password">
  <div class="le-container le-rte-wrap" style="text-align:center; max-width:560px;">
    <a class="le-logo" href="#" style="font-size:2rem;">Little<span class="le-logo__accent">Ease</span></a>
    <h1 class="le-h2">Something gentle is on its way.</h1>
    <p>{{ shop.password_message | default: 'We’re putting the finishing touches on calmer nights for UK families. Enter the store password to take a peek.' }}</p>

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="le-form__error">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
      {%- endif -%}
      <div class="le-password__row">
        <input type="password" name="password" placeholder="Store password" aria-label="Store password" required>
        <button type="submit" class="le-btn le-btn--primary">Enter</button>
      </div>
    {%- endform -%}
  </div>
</section>
