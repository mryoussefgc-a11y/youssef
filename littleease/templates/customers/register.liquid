{% section 'nav' %}
<section class="section">
  <div class="container" style="max-width:420px;">
    <h1>Create account</h1>
    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <input type="text" name="customer[first_name]" placeholder="First name" aria-label="First name">
      <input type="text" name="customer[last_name]" placeholder="Last name" aria-label="Last name" style="margin-top:0.6rem;">
      <input type="email" name="customer[email]" placeholder="Email" aria-label="Email" style="margin-top:0.6rem;">
      <input type="password" name="customer[password]" placeholder="Password" aria-label="Password" style="margin-top:0.6rem;">
      <button type="submit" class="btn btn--primary" style="margin-top:1rem;">Create</button>
    {% endform %}
  </div>
</section>
{% section 'footer' %}
