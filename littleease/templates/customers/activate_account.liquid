{% section 'nav' %}
<section class="section">
  <div class="container" style="max-width:420px;">
    <h1>Activate account</h1>
    {% form 'activate_customer_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="customer[password]" placeholder="Password" aria-label="Password">
      <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" aria-label="Confirm password" style="margin-top:0.6rem;">
      <button type="submit" class="btn btn--primary" style="margin-top:1rem;">Activate</button>
    {% endform %}
  </div>
</section>
{% section 'footer' %}
