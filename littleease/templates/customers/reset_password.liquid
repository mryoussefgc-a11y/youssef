{% section 'nav' %}
<section class="section">
  <div class="container" style="max-width:420px;">
    <h1>Reset password</h1>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="customer[password]" placeholder="New password" aria-label="New password">
      <input type="password" name="customer[password_confirmation]" placeholder="Confirm password" aria-label="Confirm password" style="margin-top:0.6rem;">
      <button type="submit" class="btn btn--primary" style="margin-top:1rem;">Reset</button>
    {% endform %}
  </div>
</section>
{% section 'footer' %}
