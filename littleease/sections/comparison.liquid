{%- comment -%}
  Comparison — "what is already in your changing bag and why it stops working".
  Desktop: a real <table>. Mobile (<=920px): the same data restructured into
  stacked cards (CSS swaps them) so a 4-column data table never overflows a phone.
  One criterion ("Reaches the jaw pathway") ties back to the core mechanism.
  The LittleEase row/card is highlighted in clay-soft.
{%- endcomment -%}
<section class="comparison section" aria-labelledby="compareHeading">
  <div class="container">
    <div class="compare__head">
      <p class="eyebrow">{{ section.settings.eyebrow | default: 'An honest comparison' }}</p>
      <h2 id="compareHeading">{{ section.settings.heading | default: 'What is already in your changing bag — and why it stops working' }}</h2>
    </div>

    {%- comment -%} ---------- Desktop table ---------- {%- endcomment -%}
    <table class="compare-table">
      <thead>
        <tr>
          <th scope="col">Approach</th>
          <th scope="col">Reaches the jaw pathway</th>
          <th scope="col">Lasts beyond a few minutes</th>
          <th scope="col">Fine to use overnight</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">Teething rings</th>
          <td class="no">No &middot; gum surface only</td>
          <td class="no">No &middot; until they drop it</td>
          <td class="no">No &middot; not for sleep</td>
        </tr>
        <tr>
          <th scope="row">Numbing gels</th>
          <td class="no">No &middot; numbs the gum</td>
          <td class="no">No &middot; wears off fast</td>
          <td class="no">No &middot; daily dose limits</td>
        </tr>
        <tr>
          <th scope="row">Amber necklaces</th>
          <td class="no">No &middot; no real mechanism</td>
          <td class="no">No &middot; worn, not active</td>
          <td class="no">No &middot; choking risk</td>
        </tr>
        <tr class="row--us">
          <th scope="row">LittleEase</th>
          <td class="yes">Yes &middot; rolled along the nerve line</td>
          <td class="yes">Yes &middot; calms for hours</td>
          <td class="yes">Yes &middot; outside the mouth</td>
        </tr>
      </tbody>
    </table>

    {%- comment -%} ---------- Mobile cards (same data) ---------- {%- endcomment -%}
    <div class="compare-cards" aria-hidden="true">
      <article class="compare-card">
        <h3>Teething rings</h3>
        <dl>
          <dt>Reaches the jaw pathway</dt><dd class="no">No — gum surface only</dd>
          <dt>Lasts beyond a few minutes</dt><dd class="no">No — until they drop it</dd>
          <dt>Fine to use overnight</dt><dd class="no">No — not for sleep</dd>
        </dl>
      </article>
      <article class="compare-card">
        <h3>Numbing gels</h3>
        <dl>
          <dt>Reaches the jaw pathway</dt><dd class="no">No — numbs the gum</dd>
          <dt>Lasts beyond a few minutes</dt><dd class="no">No — wears off fast</dd>
          <dt>Fine to use overnight</dt><dd class="no">No — daily dose limits</dd>
        </dl>
      </article>
      <article class="compare-card">
        <h3>Amber necklaces</h3>
        <dl>
          <dt>Reaches the jaw pathway</dt><dd class="no">No — no real mechanism</dd>
          <dt>Lasts beyond a few minutes</dt><dd class="no">No — worn, not active</dd>
          <dt>Fine to use overnight</dt><dd class="no">No — choking risk</dd>
        </dl>
      </article>
      <article class="compare-card compare-card--us">
        <h3>LittleEase</h3>
        <dl>
          <dt>Reaches the jaw pathway</dt><dd class="yes">Yes — along the nerve line</dd>
          <dt>Lasts beyond a few minutes</dt><dd class="yes">Yes — calms for hours</dd>
          <dt>Fine to use overnight</dt><dd class="yes">Yes — outside the mouth</dd>
        </dl>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Comparison",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "An honest comparison" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What is already in your changing bag — and why it stops working" }
  ]
}
{% endschema %}
