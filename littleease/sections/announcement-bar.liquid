{%- comment -%}
  Announcement / trust strip. Rotates through messages on mobile (CSS),
  shows all three inline on desktop.
{%- endcomment -%}
<div class="le-announce" style="--announce-bg: {{ section.settings.bg_color }}; --announce-fg: {{ section.settings.text_color }};">
  <div class="le-container le-announce__inner">
    {%- for block in section.blocks -%}
      <span class="le-announce__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'truck' -%}{% render 'icon', name: 'truck' %}
          {%- when 'shield' -%}{% render 'icon', name: 'shield-check' %}
          {%- when 'heart' -%}{% render 'icon', name: 'heart' %}
          {%- when 'leaf' -%}{% render 'icon', name: 'leaf' %}
        {%- endcase -%}
        <span>{{ block.settings.text }}</span>
      </span>
    {%- else -%}
      <span class="le-announce__item">{% render 'icon', name: 'truck' %}<span>Free UK shipping over £30</span></span>
      <span class="le-announce__item">{% render 'icon', name: 'shield-check' %}<span>30-day money-back guarantee</span></span>
      <span class="le-announce__item">{% render 'icon', name: 'heart' %}<span>243 UK mums trust LittleEase</span></span>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#4a6349" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#f9f6f0" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" },
            { "value": "leaf", "label": "Leaf" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK shipping over £30" }
      ]
    }
  ],
  "max_blocks": 5,
  "default": {
    "blocks": [
      { "type": "message", "settings": { "icon": "truck", "text": "Free UK shipping over £30" } },
      { "type": "message", "settings": { "icon": "shield", "text": "30-day money-back guarantee" } },
      { "type": "message", "settings": { "icon": "heart", "text": "243 UK mums trust LittleEase" } }
    ]
  },
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "icon": "truck", "text": "Free UK shipping over £30" } },
        { "type": "message", "settings": { "icon": "shield", "text": "30-day money-back guarantee" } },
        { "type": "message", "settings": { "icon": "heart", "text": "243 UK mums trust LittleEase" } }
      ]
    }
  ]
}
{% endschema %}
