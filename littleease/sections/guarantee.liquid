{%- comment -%}
  Guarantee — seal + a promise framed around removing the customer's specific
  objection ("another miracle baby product"), with no return-shipping friction.
{%- endcomment -%}
<section class="guarantee section" aria-labelledby="guaranteeHeading">
  <div class="container">
    <div class="guarantee__inner">
      <span class="guarantee__seal" aria-hidden="true">
        <svg width="84" height="84" viewBox="0 0 84 84" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M42 6l9 6 11-1 3 11 9 7-5 10 2 11-11 3-6 9-10-4-10 4-6-9-11-3 2-11-5-10 9-7 3-11 11 1z"/>
          <path d="M30 42l8 8 16-17"/>
        </svg>
      </span>
      <div class="guarantee__body">
        <p class="eyebrow">{{ section.settings.eyebrow | default: 'The 30-night promise' }}</p>
        <h2 id="guaranteeHeading">{{ section.settings.heading | default: 'If it does not help, you do not pay.' }}</h2>
        <p>{{ section.settings.body | default: 'You have been burned by miracle baby products before — so try LittleEase for thirty nights on us. If your evenings are not calmer, email us and we refund you in full. You keep the bottle, and there is nothing to post back. The only thing you are risking is one more sleepless week without it.' }}</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Guarantee",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The 30-night promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "If it does not help, you do not pay." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "You have been burned by miracle baby products before — so try LittleEase for thirty nights on us. If your evenings are not calmer, email us and we refund you in full. You keep the bottle, and there is nothing to post back." }
  ]
}
{% endschema %}
