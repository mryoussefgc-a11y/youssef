{%- comment -%} Minimal dark footer with Shopify policy links. {%- endcomment -%}
<footer class="le-footer">
  <div class="le-container le-footer__inner">
    <div class="le-footer__brand">
      <a class="le-logo le-logo--light" href="{{ routes.root_url }}">Little<span class="le-logo__accent">Ease</span></a>
      <p class="le-footer__tag">{{ section.settings.tagline | default: 'Natural teething relief, made with care for UK families.' }}</p>
    </div>

    <nav class="le-footer__links" aria-label="Footer">
      {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">Privacy Policy</a>{%- endif -%}
      {%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">Refund Policy</a>{%- endif -%}
      {%- if shop.shipping_policy != blank -%}<a href="{{ shop.shipping_policy.url }}">Shipping Policy</a>{%- endif -%}
      {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">Terms of Service</a>{%- endif -%}
      <a href="{{ routes.root_url }}">Contact</a>
    </nav>
  </div>

  <div class="le-footer__bar">
    <div class="le-container le-footer__bar-inner">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <span class="le-footer__disclaimer">{{ section.settings.disclaimer | default: 'For external use only. Not a medical device. If symptoms persist, consult your GP or health visitor.' }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Natural teething relief, made with care for UK families." },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "For external use only. Not a medical device. If symptoms persist, consult your GP or health visitor." }
  ]
}
{% endschema %}
