{%- comment -%}
  Renders a 5-star rating row.
  Usage: {% render 'stars', rating: 5, count: '243' %}
{%- endcomment -%}
{%- liquid
  assign r = rating | default: 5 | round
  if r > 5
    assign r = 5
  endif
-%}
<span class="le-stars" role="img" aria-label="{{ r }} out of 5 stars">
  {%- for i in (1..5) -%}
    {%- if i <= r -%}
      {% render 'icon', name: 'star' %}
    {%- else -%}
      {% render 'icon', name: 'star-outline' %}
    {%- endif -%}
  {%- endfor -%}
</span>
{%- if count -%}<span class="le-stars__count">{{ count }}</span>{%- endif -%}
