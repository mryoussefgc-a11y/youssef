{
  "manifest_version": 3,
  "name": "My1MDollar",
  "version": "1.2.0",
  "description": "Keyword search or full subreddit export to .txt — kaykhdem f background. Jbed l'flous mn Reddit.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "My1MDollar"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["downloads", "storage", "notifications"],
  "host_permissions": ["https://www.reddit.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
