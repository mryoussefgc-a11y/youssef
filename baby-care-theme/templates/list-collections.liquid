<section class="section">
  <div class="wrap">
    <h1 class="center">Collections</h1>
    <div class="pgrid" style="margin-top:30px">
      {% for collection in collections %}
        <a href="{{ collection.url }}" class="pcard">
          <div class="ph">
            {% if collection.featured_image %}
              <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.title | escape }}">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <div class="pb"><div class="pt">{{ collection.title }}</div></div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
