<section class="section">
  <div class="wrap" style="max-width:460px">
    <h1 class="center">Create Account</h1>
    {% form 'create_customer' %}
      {{ form.errors | default_errors }}
      <p><input type="text" name="customer[first_name]" placeholder="First name" style="width:100%;padding:13px;border:1px solid var(--beige);border-radius:10px"></p>
      <p><input type="text" name="customer[last_name]" placeholder="Last name" style="width:100%;padding:13px;border:1px solid var(--beige);border-radius:10px"></p>
      <p><input type="email" name="customer[email]" placeholder="Email" style="width:100%;padding:13px;border:1px solid var(--beige);border-radius:10px"></p>
      <p><input type="password" name="customer[password]" placeholder="Password" style="width:100%;padding:13px;border:1px solid var(--beige);border-radius:10px"></p>
      <button type="submit" class="btn btn--block">Create</button>
    {% endform %}
  </div>
</section>
