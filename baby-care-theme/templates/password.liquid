<section class="section center">
  <div class="wrap" style="max-width:520px">
    <h1>{{ shop.name }}</h1>
    <p class="muted">{{ shop.password_message | default: "We're opening soon. Enter the store using the password." }}</p>
    {% form 'storefront_password' %}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Password" style="padding:13px 18px;border:1px solid var(--beige);border-radius:999px;width:min(320px,90%)">
      <button type="submit" class="btn">Enter</button>
    {% endform %}
  </div>
</section>
