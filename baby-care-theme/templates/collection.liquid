<section class="section">
  <div class="wrap">
    <h1 class="center">{{ collection.title }}</h1>
    {% if collection.description != blank %}<p class="center muted" style="max-width:60ch;margin:0 auto 36px">{{ collection.description }}</p>{% endif %}
    <div class="pgrid" style="margin-top:30px">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>No products found.</p>
      {% endfor %}
    </div>
  </div>
</section>
