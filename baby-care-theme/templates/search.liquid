<section class="section">
  <div class="wrap">
    <h1 class="center">Search</h1>
    <form action="{{ routes.search_url }}" method="get" class="center" style="margin-bottom:30px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products..." style="padding:13px 18px;border:1px solid var(--beige);border-radius:999px;width:min(420px,90%)">
      <button type="submit" class="btn">Search</button>
    </form>
    {% if search.performed %}
      <div class="pgrid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}
        {% else %}
          <p class="center">No results for "{{ search.terms | escape }}".</p>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>
