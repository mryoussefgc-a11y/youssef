{%- comment -%} Inline line-style SVG icons. Usage: {% render 'icon', name: 'leaf' %} {%- endcomment -%}
{%- assign s = '0 0 24 24' -%}
<span class="svg-icon" aria-hidden="true">
{%- case name -%}
{%- when 'leaf' -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
{%- when 'heart' -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
{%- when 'flower' -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2.6"/><path d="M12 9.4V3.5M12 14.6V20.5M9.4 12H3.5M14.6 12H20.5M10.1 10.1 6 6M17.9 17.9 13.9 13.9M13.9 10.1 17.9 6M10.1 13.9 6 17.9"/></svg>
{%- when 'drop' -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5S12.5 5 12 2.5C11.5 5 10 7.4 8 9.5S5 13 5 15a7 7 0 0 0 7 7Z"/></svg>
{%- when 'shield' -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 11.5 2 2 4-4"/></svg>
{%- when 'bottle' -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2h5M10.5 2v3.5M13.5 2v3.5"/><path d="M8.5 9.5a3 3 0 0 1 3-3h1a3 3 0 0 1 3 3V20a2 2 0 0 1-2 2h-3a2 2 0 0 1-2-2Z"/><path d="M8.5 12.5h7"/></svg>
{%- when 'sparkle' -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v6M12 15v6M3 12h6M15 12h6"/><path d="M12 9a3 3 0 0 0 3 3 3 3 0 0 0-3 3 3 3 0 0 0-3-3 3 3 0 0 0 3-3Z"/></svg>
{%- when 'truck' -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 5h11v10H2zM13 8h4l4 4v3h-8z"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
{%- when 'check' -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
{%- when 'star' -%}
  <svg viewBox="{{ s }}" fill="currentColor"><path d="M12 2l2.95 6.05L21.5 9l-4.75 4.55L17.9 21 12 17.6 6.1 21l1.15-7.45L2.5 9l6.55-.95Z"/></svg>
{%- when 'roller' -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="2.2"/><path d="M9.8 8h4.4a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H9.8a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2Z"/></svg>
{%- else -%}
  <svg viewBox="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/></svg>
{%- endcase -%}
</span>
